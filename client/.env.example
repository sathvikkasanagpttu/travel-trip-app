# ==============================================================================
# Travel Trip Client Environment Configuration (Vite)
# ==============================================================================

# Backend REST API Base URL
# In local development: /api/v1 (relies on Vite proxy to http://localhost:5001)
# In production on Vercel: https://travel-trip-api.onrender.com/api/v1
VITE_API_URL="/api/v1"

# Backend Socket.IO Gateway URL
# In local development: http://localhost:5001
# In production on Vercel: https://travel-trip-api.onrender.com
VITE_SOCKET_URL="http://localhost:5001"
