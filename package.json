{
  "name": "travel-trip-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "client": "npm run dev --workspace=client",
    "server": "npm run dev --workspace=server",
    "test": "npm test --workspace=client && npm test --workspace=server",
    "build": "npm run build --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
