PORT=5001
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="your-jwt-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
CLIENT_URL="http://localhost:5173"
COOKIE_DOMAIN=""
COOKIE_SECURE="false"

# SMTP Email Settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Travel Trip <no-reply@traveltrip.com>"

# Nominatim OpenStreetMap Proxy
NOMINATIM_USER_AGENT="TravelTripApp/1.0 (contact@traveltrip.com)"

# Quote Engine Pricing Rates
QUOTE_RATE_PER_KM="5"
QUOTE_NIGHT_RATE="1000"
QUOTE_ASSISTANCE_SURCHARGE="500"

# Auto-Confirm Simulation (0 = off, >0 = seconds delay)
AUTO_CONFIRM_SECONDS="0"
