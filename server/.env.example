# ==============================================================================
# Travel Trip Server Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development # development | production | test

# Database Connection URL
# For SQLite (local development):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Production / Supabase / Neon / Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/traveltrip?schema=public"
# For Supabase / Neon pooled connection:
# DATABASE_URL="postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT Authentication Secrets
# Generate random strings using `openssl rand -hex 32`
JWT_ACCESS_SECRET="travel-trip-jwt-access-super-secret-key-2026-safe-random-phrase"
JWT_REFRESH_SECRET="travel-trip-jwt-refresh-super-secret-key-2026-safe-random-phrase"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS & Client Application URL
# In development: http://localhost:5173
# In production: https://travel-trip-app.vercel.app
CLIENT_URL="http://localhost:5173"

# Cookie Security & Cross-Domain Settings
# When frontend and backend are hosted on different domains (e.g. Vercel + Render):
# Set COOKIE_SAME_SITE="none" and COOKIE_SECURE="true"
COOKIE_SAME_SITE="lax" # lax (same-origin / dev) | none (cross-domain prod)
COOKIE_SECURE="false"  # false in HTTP dev, true in HTTPS prod
COOKIE_DOMAIN=""       # Optional: shared root domain (e.g., ".yourdomain.com")

# SMTP Email Configuration (Nodemailer)
# Leave blank in dev to log to console / Ethereal test inbox
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Travel Trip <no-reply@traveltrip.com>"

# Nominatim OpenStreetMap Proxy User-Agent
NOMINATIM_USER_AGENT="TravelTripApp/1.0 (contact@traveltrip.com)"

# Quote Engine Pricing Rates (in INR ₹)
QUOTE_RATE_PER_KM="5"
QUOTE_NIGHT_RATE="1000"
QUOTE_ASSISTANCE_SURCHARGE="500"

# Auto-Confirm Simulation (in seconds; 0 = off, >0 = auto-confirms PENDING bookings)
AUTO_CONFIRM_SECONDS="0"

# Optional: Seed default accounts on container startup
SEED_ON_START="false"
